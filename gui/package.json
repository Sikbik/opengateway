{
  "name": "factory-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run web",
    "web": "vite --host 127.0.0.1 --port 1420",
    "desktop": "npm run desktop:prepare-sidecar -- --debug && tauri dev",
    "desktop:prepare-sidecar": "node ./scripts/prepare-sidecar.mjs",
    "desktop:check": "npm run desktop:prepare-sidecar -- --debug && cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "npm run desktop:prepare-sidecar && tauri build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "esbuild": "0.28.1",
    "picomatch": "4.0.4",
    "postcss": "8.5.10"
  }
}
